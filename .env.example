# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (Whisper Large v3 — optional, free tier, for voice transcription)
# Get your key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Drive (OAuth 2.0 user credentials — files owned by your real Google account)
# GOOGLE_DRIVE_CREDENTIALS_FILE — path to OAuth 2.0 client secrets JSON
#   (download from Google Cloud Console → APIs & Services → Credentials →
#   "OAuth 2.0 Client IDs", Desktop app type). NOT a service-account JSON.
# GOOGLE_DRIVE_TOKEN_FILE — path where the obtained user token (with refresh
#   token) is persisted between runs. Created automatically on first run after
#   the one-time browser-based consent.
#
# Both paths are interpreted inside the container (working dir /app). For the
# `prod` docker-compose profile, the files are mounted automatically from the
# host directory that contains `docker-compose.yml`: place `credentials.json`
# and `token.json` next to it and keep the values below as-is. token.json is
# mounted read-write so the Google OAuth library can rewrite it after a
# refresh; credentials.json is mounted read-only.
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Database
# When running via Docker (recommended): set by docker-compose automatically
# For local runs without Docker: sqlite+aiosqlite:///data/bot.db
DATABASE_URL=postgresql+asyncpg://inbox:inbox@localhost/inbox

# Docker PostgreSQL password (used in docker-compose.yml)
POSTGRES_PASSWORD=change_me_in_production

# Bot settings
# Comma-separated list of Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=your_telegram_user_id_here

# Semantic search — dimensionality of embeddings (must match pgvector column size).
# Default 1536 matches OpenAI text-embedding-3-small. Changing requires an Alembic migration.
EMBEDDING_DIM=1536

# GitHub Container Registry — credentials for Watchtower to pull updated images
# (only required for the prod profile, which uses ghcr.io/krabbi/tg-smart-inbox:latest)
# GHCR_USER — GitHub username (e.g. krabbi)
# GHCR_TOKEN — Personal Access Token with the read:packages scope
GHCR_USER=your_github_username_here
GHCR_TOKEN=your_github_pat_with_read_packages_scope_here
