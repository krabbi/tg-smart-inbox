# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (Whisper Large v3 — optional, free tier, for voice transcription)
# Get your key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Database
# When running via Docker (recommended): set by docker-compose automatically
# For local runs without Docker: sqlite+aiosqlite:///data/bot.db
DATABASE_URL=postgresql+asyncpg://inbox:inbox@localhost/inbox

# Docker PostgreSQL password (used in docker-compose.yml)
POSTGRES_PASSWORD=inbox

# Bot settings
# Comma-separated list of Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=your_telegram_user_id_here
